# Percorso al client_secrets.json scaricato da Google Cloud Console.
# Default: ~/.config/google-chat-mcp/client_secrets.json
# GOOGLE_CLIENT_SECRETS=/path/to/client_secrets.json

# Spazi usati dai test di integrazione (pytest -m integration).
# Trova gli ID con: google-chat-mcp spaces
# CHAT_READ_WRITE_SPACE=spaces/AAABBBCCC   # spazio configurato come rw
# CHAT_READ_ONLY_SPACE=spaces/DDDEEEFFF    # spazio configurato come r
# CHAT_UNCONFIGURED_SPACE=spaces/GGGHHH111 # spazio esistente ma non nel server config
