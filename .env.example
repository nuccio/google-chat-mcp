# Percorso al client_secrets.json scaricato da Google Cloud Console.
# Default: ~/.config/google-chat-mcp/client_secrets.json
# GOOGLE_CLIENT_SECRETS=/path/to/client_secrets.json

# Spaces used by the integration tests (pytest -m integration).
# `python -m tests.setup_env` fills these in, finding or creating the spaces
# described in tests/test_env.toml: see tests/README.md.
# CHAT_READ_ONLY_SPACE=spaces/AAABBBCCC
# CHAT_WRITE_ONLY_SPACE=spaces/DDDEEEFFF
# CHAT_READ_WRITE_CONFIRM_SPACE=spaces/GGGHHHIII
# CHAT_READ_WRITE_UNATTENDED_SPACE=spaces/JJJKKKLLL
# CHAT_UNCONFIGURED_SPACE=spaces/MMMNNNOOO

# The setup only reads this one: it must be set by hand, see tests/README.md.
# It must be a direct message with an account dedicated to testing, never
# someone's main account. Without it, the direct message tests are skipped.
# CHAT_DIRECT_MESSAGE_SPACE=spaces/PPPQQQRRR
